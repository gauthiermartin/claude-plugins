{
  "name": "semantic-branch-names",
  "target": "branch",
  "enforcement": "active",
  "conditions": { "ref_name": { "include": ["~ALL"], "exclude": ["~DEFAULT_BRANCH"] } },
  "rules": [
    {
      "type": "branch_name_pattern",
      "parameters": {
        "name": "Branch names follow <type>/<kebab-description>",
        "operator": "regex",
        "pattern": "^(feat|fix|chore|docs|refactor|test|ci|build|perf|style|revert)/[a-z0-9._/-]+$",
        "negate": false
      }
    }
  ],
  "bypass_actors": [
    { "actor_id": 5, "actor_type": "RepositoryRole", "bypass_mode": "always" }
  ]
}
